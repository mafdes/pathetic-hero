{
  "name": "pathetic-hero",
  "version": "0.3.1",
  "description": "Un RPG satírico medieval donde el aspirante a héroe fracasa estrepitosamente en las pruebas del Gremio. Pixel art retro estilo SNES/Mega Drive.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "split:enemy": "python3 tools/split-spritesheet.py",
    "organize:enemy": "python3 tools/organize-enemy.py",
    "build:enemies": "node tools/build-enemies.js",
    "build": "npm run build:enemies && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
